NODE_ENV=development
PORT=4000

# Orígenes del frontend permitidos por CORS (separados por coma, sin "/" final).
FRONTEND_URL=http://localhost:5173

# Cuántos proxies hay delante de la API (nginx, Cloudflare, balanceador...).
# 0 = ninguno (la IP del cliente es la de la conexión). Si hay uno, pon 1.
# No lo subas "por si acaso": con un valor incorrecto la IP puede falsificarse.
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=indemnizacion_ipc
DB_POOL_SIZE=10

# OBLIGATORIO en producción: mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En desarrollo, si lo dejas vacío se usa uno temporal (las sesiones se pierden al reiniciar).
JWT_SECRET=

# Clave para cifrar los secretos de la verificación en dos pasos (2FA), mínimo 32 caracteres.
# Si la dejas vacía se usa JWT_SECRET; pero si algún día cambias JWT_SECRET, los 2FA ya
# configurados dejarían de funcionar. Una clave propia y fija evita ese problema.
# TOTP_ENCRYPTION_KEY=

# Vida del token de acceso (segundos) y de la sesión renovable (días).
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_DAYS=7

# Cookie de sesión. En producción se marca Secure automáticamente.
# Si frontend y API están en dominios distintos usa COOKIE_SAMESITE=none (requiere HTTPS).
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# Bloqueo de cuenta tras intentos fallidos.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
